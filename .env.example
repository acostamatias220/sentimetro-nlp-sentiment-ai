# Copy to `.env` and fill in. `.env` is git-ignored: never commit real values.

# --- Training ---------------------------------------------------------------
# Optional Hugging Face token: only raises download rate limits (the dataset and
# the base model are public). Create one at https://huggingface.co/settings/tokens
HF_TOKEN=
# Where Hugging Face caches models/datasets (optional)
HF_HOME=

# --- Inference API (all optional) -------------------------------------------
SENTIMETRO_MODEL_DIR=models/production
# If set, POST /predict requires the header `X-API-Key: <value>`.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SENTIMETRO_API_KEY=
SENTIMETRO_MAX_BATCH_SIZE=64
SENTIMETRO_MAX_TEXT_CHARS=5000
# JSON list, e.g. ["http://localhost:5173"]
SENTIMETRO_CORS_ORIGINS=[]
SENTIMETRO_LOG_LEVEL=INFO
SENTIMETRO_LOG_JSON=true
SENTIMETRO_ENABLE_DEMO=true
# ONNX Runtime intra-op threads (0 = let ONNX Runtime decide)
SENTIMETRO_ORT_THREADS=0

# --- docker compose -----------------------------------------------------------
API_PORT=8000
PROMETHEUS_PORT=9090
